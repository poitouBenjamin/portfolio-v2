# Envoi du brief projet par email (https://resend.com)
RESEND_API_KEY=

# Optionnel : destinataire (par défaut, l’email de lib/site.ts)
BRIEF_TO=

# Optionnel : expéditeur. Sans domaine vérifié chez Resend, garder la valeur par défaut,
# qui ne peut envoyer qu’à l’adresse du compte Resend.
BRIEF_FROM=Portfolio <onboarding@resend.dev>

# Aperçu IA du brief : stockage des pistes générées et limite anti-abus.
# Upstash Redis, via le Marketplace Vercel (KV_REST_API_URL / KV_REST_API_TOKEN sont aussi acceptées).
# Sans ces variables, la mémoire du serveur suffit en local ; l’étape est refusée en production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Paiement du déblocage des pistes 2 et 3 (https://dashboard.stripe.com/apikeys).
# Sans clés, hors production, un bouton « DEV · débloquer sans payer » les remplace.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
